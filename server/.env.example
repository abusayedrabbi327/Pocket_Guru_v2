# PocketGuru Backend Server Environment
PORT=5000
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

# OpenRouter AI Engine Key & Models
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_PRIMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free,meta-llama/llama-3.3-70b-instruct:free,google/gemini-2.0-flash-exp:free
